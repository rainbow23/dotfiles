{
  "title": "IME: Escape で未確定文字をキャンセルして英語に切替",
  "rules": [
    {
      "description": "日本語入力中の Escape → 英数キーで未確定文字キャンセル → Escape 送信",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "escape"
          },
          "to": [
            {
              "key_code": "japanese_eisuu"
            },
            {
              "key_code": "escape"
            }
          ],
          "conditions": [
            {
              "type": "input_source_if",
              "input_sources": [
                {
                  "language": "ja"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
